# Project-specific R8 keep rules.
# AGP combines all keep rule files in src/main/keepRules for R8 release builds.

# Keep kotlinx.serialization API data models and generated serializers
-keep,includedescriptorclasses class com.example.pedalpalooza.data.**$$serializer { *; }
-keepclassmembers class com.example.pedalpalooza.data.** {
    *** Companion;
}
-keepclasseswithmembers class com.example.pedalpalooza.data.** {
    kotlinx.serialization.KSerializer serializer(...);
}

# Keep WorkManager worker constructors invoked via reflection
-keep class com.example.pedalpalooza.notifications.RideReminderWorker {
    public <init>(android.content.Context, androidx.work.WorkerParameters);
}